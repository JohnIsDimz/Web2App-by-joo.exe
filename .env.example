# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PTERODACTYL_SERVER_URL: Endpoint for external Pterodactyl VPS Node build server (optional)
PTERODACTYL_SERVER_URL=""

# PTERODACTYL_ACTIVE: Set to "true" when Pterodactyl VPS node is active and connected
PTERODACTYL_ACTIVE="false"

# RESEND_API_KEY: Optional API key for sending real emails via Resend transactional email API
RESEND_API_KEY=""

# BUATQRIS_ACCOUNT_ID: Account ID for https://api.buatqris.site
BUATQRIS_ACCOUNT_ID="user_6a78b39d4f8481.*****"

# BUATQRIS_SECRET_TOKEN: Secret Token / API key for https://api.buatqris.site
BUATQRIS_SECRET_TOKEN="sk_live_868626fa7613994c1fc10b812afc86cd119db324bb5afccee"
